{
  // The profile uses responsive SVG artwork and GitHub-supported inline HTML.
  "config": {
    "MD013": false, // line-length: descriptive alt text and asset links
    "MD033": false, // inline HTML: responsive <picture> and <details> blocks
    "MD041": false // first-line-heading: profile opens with a graphic masthead
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", ".preview/**"]
}
